# systemd unit for the SST Cam firmware runtime on the Jetson.
#
# Install (one-time, on the device):
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin sst-cam
#   sudo mkdir -p /opt/sst-cam/bin
#   sudo chown -R sst-cam:sst-cam /opt/sst-cam
#   sudo cp deploy/sst-cam-firmware.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable sst-cam-firmware
# (then run deploy/install.sh to place the binary and start the service)

[Unit]
Description=SST Cam firmware runtime
# Order after boot services and physical NIC discovery; absent hardware stays optional.
After=network-pre.target bluetooth.service nvargus-daemon.service sst-cam-wpa-p2p.service sys-subsystem-net-devices-wlP1p1s0.device sys-subsystem-net-devices-enP8p1s0.device
Wants=network-pre.target bluetooth.service nvargus-daemon.service sst-cam-wpa-p2p.service sys-subsystem-net-devices-wlP1p1s0.device sys-subsystem-net-devices-enP8p1s0.device
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/sst-cam
ExecStart=/opt/sst-cam/bin/sst_cam_firmware
Restart=on-failure
RestartSec=10
WatchdogSec=60
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
